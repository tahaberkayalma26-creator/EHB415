+// Counts the union of PRS REs that would otherwise carry PDSCH data. This only feeds the experimental TBS model;
+// it does not reserve PHY REs or implement PDSCH rate matching around PRS.
+static unsigned count_prs_data_re(const cell_slot_resource_allocator&          pdsch_alloc,
+                                  const pdsch_config_params&                   pdsch_cfg,
+                                  subcarrier_spacing                           scs,
+                                  const std::pair<crb_interval, crb_interval>& crbs)
+{
+  if (pdsch_alloc.result.dl.prs.empty()) {
+    return 0;
+  }
+
+  unsigned nof_prs_data_re = 0;
+  for (unsigned symbol = pdsch_cfg.symbols.start(); symbol != pdsch_cfg.symbols.stop(); ++symbol) {
+    unsigned dmrs_mask = 0;
+    if (pdsch_cfg.dmrs.dmrs_symb_pos.test(symbol)) {
+      const unsigned nof_cdm_groups = pdsch_cfg.dmrs.num_dmrs_cdm_grps_no_data;
+      for (unsigned k = 0; k != NOF_SUBCARRIERS_PER_RB; ++k) {
+        // Same no-data masks as get_dmrs_prb_mask: type 1 repeats every 2 REs, type 2 every 6 REs.
+        const bool is_dmrs = pdsch_cfg.dmrs.config_type == dmrs_config_type::type1
+                                 ? k % 2U < nof_cdm_groups
+                                 : k % 6U < 2U * nof_cdm_groups;
+        if (is_dmrs) {
+          dmrs_mask |= 1U << k;
+        }
+      }
+    }
+
+    // The two ranges are the final physical allocation, including interleaved VRB-to-PRB mapping.
+    for (const crb_interval& range : {crbs.first, crbs.second}) {
+      for (unsigned crb = range.start(); crb != range.stop(); ++crb) {
+        unsigned prs_mask = 0;
+        for (const prs_info& prs : pdsch_alloc.result.dl.prs) {
+          if (prs.scs != scs or not prs.crbs.contains(crb) or not prs.symbols.contains(symbol)) {
+            continue;
+          }
+          const unsigned comb = to_underlying(prs.comb_size);
+          const unsigned offset =
+              (prs.comb_offset + get_prs_freq_offset(prs.comb_size, symbol - prs.symbols.start())) % comb;
+          for (unsigned k = offset; k < NOF_SUBCARRIERS_PER_RB; k += comb) {
+            prs_mask |= 1U << k;
+          }
+        }
+        // Union first, then exclude DM-RS no-data REs that have already been subtracted from the TBS budget.
+        const unsigned data_mask = prs_mask & ~dmrs_mask;
+        for (unsigned k = 0; k != NOF_SUBCARRIERS_PER_RB; ++k) {
+          nof_prs_data_re += (data_mask >> k) & 1U;
+        }
+      }
+    }
+  }
+  return nof_prs_data_re;
+}
 
